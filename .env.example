# Copy to .env and fill in — never commit the real .env file.
# These are PUBLIC Firebase client identifiers, safe to ship in the app bundle.
# Security is enforced by Firestore/Storage Security Rules, not by hiding this config.
EXPO_PUBLIC_FIREBASE_API_KEY=your_real_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Comma-separated list of emails that get the "admin" role on first sign-in
# (see lib/userProfile.ts). After that, roles live on each user's Firestore
# users/{uid} document and can be changed there directly.
EXPO_PUBLIC_ADMIN_EMAILS=admin@example.com
