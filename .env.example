# Copy to .env and fill in — never commit the real .env file.
# Restart Expo after editing:  npx expo start -c

# Supabase: Project Settings -> API Keys.
# Use the PUBLISHABLE (anon) key only. Row Level Security protects the data,
# so this key is safe in the app bundle. NEVER put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
